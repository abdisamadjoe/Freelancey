{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w @gigly/database -w @gigly/shared -w @gigly/email -w @gigly/api"
  },
  "deploy": {
    "startCommand": "npm run start:prod -w @gigly/api",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
