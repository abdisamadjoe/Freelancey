{
  "name": "@freelancey/api",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:integration": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('Set TEST_DATABASE_URL to a throwaway Neon branch first.');process.exit(1)}\" && RUN_INTEGRATION=true vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "npx prisma generate && npx prisma generate --schema=prisma/neon-auth.schema.prisma",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "tsx src/database/seed.ts",
    "db:backfill-clients": "tsx src/database/backfill-clients.ts",
    "prebuild": "npm run db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.4.0",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@types/compression": "^1.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.6.0",
    "nodemailer": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.1.0",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.3",
    "stripe": "^20.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@types/node": "^22.0.0",
    "@swc/core": "^1.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.4.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.0"
  }
}
