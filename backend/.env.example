# ═══════════════════════════════════════════════════════════
# Freelancey — Backend (API) Environment
# ═══════════════════════════════════════════════════════════
# NestJS API (port 3001), deployed on Railway.
# Frontend variables live in frontend/.env.example — keep them separate.
#
# Copy this file to backend/.env for local development
# (`npm run dev` does this automatically on first run).
#
# Required: DATABASE_URL, DIRECT_URL, APP_ENCRYPTION_SECRET,
# NEON_AUTH_BASE_URL, R2_* (four vars). Everything else has a sensible default.

# ── Database (Neon) ──────────────────────────────────────
# DATABASE_URL = Neon's pooled connection string (used at runtime)
# DIRECT_URL   = Neon's direct (unpooled) connection string (used by `prisma migrate`)
DATABASE_URL="postgresql://user:pass@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# ── App-level secret (settings encryption, push subscriptions, payment
#    signing — decoupled from the auth provider) — min 32 chars ────────
APP_ENCRYPTION_SECRET="change-me-in-production-min-32-chars"

# ── Authentication (Neon Auth — Managed Better Auth) ─────
# "Auth URL" from your Neon project's Auth tab (includes the project's
# db-name path segment). Used for stateless JWT verification via JWKS.
NEON_AUTH_BASE_URL=""

# ── Object storage (Cloudflare R2) ───────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="freelancey"

# ── App URLs ──────────────────────────────────────────────
# WEB_URL = frontend origin (CORS, notification links, payment redirects)
# API_URL = this API's public URL (Stripe webhooks, branding logo URLs)
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ── Email (Resend) — optional, setup wizard handles this if unset ──
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"

# File upload limit (MB)
# MAX_FILE_SIZE_MB="50"

# ── Billing (optional) ───────────────────────────────────
# BILLING_ENABLED="false"
# DEFAULT_PLAN_SLUG="free"
# STRIPE_MODE="test"
# STRIPE_TEST_SECRET_KEY=""
# STRIPE_TEST_PUBLISHABLE_KEY=""
# STRIPE_TEST_WEBHOOK_SECRET=""
# STRIPE_TEST_PRO_PRICE_ID=""
# STRIPE_TEST_LIFETIME_PRICE_ID=""
# STRIPE_LIVE_SECRET_KEY=""
# STRIPE_LIVE_PUBLISHABLE_KEY=""
# STRIPE_LIVE_WEBHOOK_SECRET=""
# STRIPE_LIVE_PRO_PRICE_ID=""
# STRIPE_LIVE_LIFETIME_PRICE_ID=""

# ── Stripe Connect (optional — enables client invoice payments) ──
# STRIPE_CONNECT_CLIENT_ID=""           # Platform Connect client ID (ca_xxx)
# STRIPE_CONNECT_WEBHOOK_SECRET=""      # Webhook secret for Connect events
# STRIPE_CURRENCY="usd"                 # Currency for invoice payments (ISO 4217)

# ── Error Reporting / Sentry (optional) ──────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx  # API server errors
# SENTRY_AUTH_TOKEN=sntrys_xxx          # Source map uploads (build-time only)
# SENTRY_ENABLED=true

# ── Rate limiting (requests per minute) ──────────────────
# Raise these for e2e test runs to avoid cascading 429s
# THROTTLE_LIMIT="100"
# SIGNUP_THROTTLE_LIMIT="5"

# Set to "false" to disable public self-serve signup (blocks new organizations).
# Login and invited-client onboarding are unaffected. Default: signups enabled.
# ALLOW_SIGNUPS="true"

# LOG_LEVEL="info"

# ═══════════════════════════════════════════════════════════
# Production (Railway — portal-api.groundwork.co.ke)
# ═══════════════════════════════════════════════════════════
# Set these directly in the Railway service's Variables — never commit
# real values to this file.
#
#   DATABASE_URL, DIRECT_URL          — Neon production branch
#   APP_ENCRYPTION_SECRET             — random 32+ char string, distinct per environment
#   NEON_AUTH_BASE_URL
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
#   WEB_URL="https://portal.groundwork.co.ke"
#   API_URL="https://portal-api.groundwork.co.ke"
#   NODE_ENV="production"
#   PORT                              — injected by Railway, do not set manually
#   SECURE_COOKIES="true"             — only needed if NODE_ENV isn't "production"
#   (plus RESEND_API_KEY / EMAIL_FROM / BILLING_ENABLED / STRIPE_* / Sentry vars as needed)
